  "capture_decision": {
    "status": "feasible",
    "decision": "1-second capture is feasible through public websocket event feeds and infeasible through REST polling.",
    "reason": [
      "NDAX's public support article states REST is limited to 50 requests per minute, which is below the 60 requests per minute required for 1-second polling.",
      "A live public SubscribeLevel2 probe produced many Level2UpdateEvent frames within a 5-second window.",
      "A live public manual SubscribeTrades probe produced a TradeDataUpdateEvent in roughly 403 ms.",
      "SubscribeTicker does not support Interval 1, so 1-second capture cannot rely on ticker bars."
    ]
  }
